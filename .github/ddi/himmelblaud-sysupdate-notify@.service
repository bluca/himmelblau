[Unit]
Description=Reattach Himmelblau after a DDI Update
Documentation=man:systemd-sysupdate(8) man:portablectl(1)
RefuseManualStart=yes

[Service]
ExecStart=/usr/libexec/himmelblaud-sysupdate-notify /usr/bin/portablectl reattach --now --enable --no-block --profile trusted /var/lib/himmelblau-ddi/himmelblaud.v/ himmelblaud himmelblau-hsm-pin-init
User=root
BindReadOnlyPaths=/var/lib/himmelblau-ddi
StandardInput=socket
StandardOutput=socket
StandardError=journal
RuntimeMaxSec=5min
